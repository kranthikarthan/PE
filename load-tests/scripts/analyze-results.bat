@echo off
REM Load Test Results Analysis Script for Windows
REM Usage: analyze-results.bat [results_directory]

setlocal enabledelayedexpansion

set RESULTS_DIR=%1
if "%RESULTS_DIR%"=="" set RESULTS_DIR=target\gatling-results

set REPORT_FILE=performance-report.md

echo 📊 Analyzing load test results from: %RESULTS_DIR%

REM Create performance report
(
echo # Performance Test Report
echo.
echo **Generated**: %date% %time%
echo **Results Directory**: %RESULTS_DIR%
echo.
echo ## Test Summary
echo.
echo ### Performance Metrics
echo - **Test Duration**: N/A
echo - **Total Requests**: N/A
echo - **Successful Requests**: N/A
echo - **Failed Requests**: N/A
echo.
echo ### Response Time Analysis
echo - **Min Response Time**: N/A
echo - **Max Response Time**: N/A
echo - **Mean Response Time**: N/A
echo - **p95 Response Time**: N/A
echo - **p99 Response Time**: N/A
echo.
echo ### Throughput Analysis
echo - **Requests per Second**: N/A
echo - **Peak TPS**: N/A
echo.
echo ## SLO Compliance
echo.
echo ### Performance Targets
echo - **Throughput**: 1,000+ TPS sustained
echo - **Latency p95**: ^< 3 seconds
echo - **Latency p99**: ^< 5 seconds
echo - **Error Rate**: ^< 1%%
echo.
echo ### Compliance Status
echo - **Throughput Target**: ❌ FAIL
echo - **p95 Latency Target**: ❌ FAIL
echo - **p99 Latency Target**: ❌ FAIL
echo - **Error Rate Target**: ❌ FAIL
echo.
echo ## Recommendations
echo.
echo ### Performance Optimization
echo 1. **Database Optimization**: Review query performance and indexing
echo 2. **Caching Strategy**: Implement Redis caching for frequently accessed data
echo 3. **Connection Pooling**: Optimize database connection pool settings
echo 4. **Async Processing**: Implement async processing for non-critical operations
echo.
echo ### Infrastructure Scaling
echo 1. **Horizontal Scaling**: Consider adding more service instances
echo 2. **Load Balancing**: Implement proper load balancing strategies
echo 3. **Resource Monitoring**: Set up comprehensive resource monitoring
echo 4. **Auto-scaling**: Implement HPA ^(Horizontal Pod Autoscaler^) for Kubernetes
echo.
echo ## Next Steps
echo.
echo 1. Review detailed Gatling HTML report: %RESULTS_DIR%\index.html
echo 2. Analyze Prometheus metrics for deeper insights
echo 3. Implement performance optimizations based on findings
echo 4. Schedule regular load testing in CI/CD pipeline
echo.
echo ---
echo *Report generated by Payments Engine Load Testing Framework*
) > "%REPORT_FILE%"

echo ✅ Performance report generated: %REPORT_FILE%
echo 📊 Detailed Gatling report available in: %RESULTS_DIR%\index.html
